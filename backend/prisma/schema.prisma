generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  AGENT
}

enum RecurrencyType {
  DAILY // Todos os dias
  WEEKLY // Dias específicos da semana
  MONTHLY // Dias específicos do mês
  YEARLY // Datas específicas do ano
  CUSTOM // Período específico (usa startDate e endDate)
}

enum IVROptionType {
  DIGIT // Opção simples de 1 dígito (0-9, *, #)
  INPUT // Captura múltiplos dígitos (CPF, CNPJ, protocolo, etc)
}

enum HttpMethod {
  GET
  POST
}

enum TrunkType {
  SIP
  PJSIP
  IAX
}

enum ExtensionType {
  SIP
  PJSIP
  IAX
}

enum ApplicationsType {
  ANNOUNCEMENT // Anúncios
  TIMECONDITION // Condições de tempo
  QUEUE // Filas
  IVR // Menu de voz
  EXTENSION // Ramais
  TRUNK // Troncos (saída externa)
  SETVARIABLE // Definir variáveis
  API // Requisições API
  VARIABLECONDITION // Validação de variáveis

  // Aplicações que não precisam de um id
  HANGUP
}

// ============================================
// MODELS
// ============================================

model User {
  id       String   @id @default(cuid())
  name     String
  username String   @unique
  password String
  token    String?
  role     UserRole @default(AGENT)
  status   Boolean  @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([username])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Company {
  id     String  @id @default(cuid())
  name   String  @unique
  status Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relacionamentos (ordem alfabética)
  announcements          Announcement[]
  apiRequests            ApiRequest[]
  apiResponseMappings    ApiResponseMapping[]
  audios                 Audio[]
  extensions             Extension[]
  inboundRoutes          InboundRoute[]
  ivrs                   IVR[]
  ivrOptions             IVROption[]
  outboundRoutes         OutboundRoute[]
  queues                 Queue[]
  setVariables           SetVariable[]
  timeConditions         TimeCondition[]
  timeRules              TimeRule[]
  trunks                 Trunk[]
  variableConditions     VariableCondition[]
  variableConditionRules VariableConditionRule[]
  variables              Variable[]

  @@index([name])
  @@index([status])
  @@map("companies")
}

model Audio {
  id       String  @id @default(cuid())
  name     String
  filename String? // Nome do arquivo no sistema (ex: "welcome.wav")

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("audios")
}

model InboundRoute {
  id             String  @id @default(cuid())
  name           String
  numberReceived String // Número DID/DDR que receberá a chamada
  description    String? // Descrição opcional

  // Destino da chamada
  destinationApp ApplicationsType
  destinationId  String? // ID do registro de destino

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@unique([companyId, numberReceived])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([numberReceived])
  @@map("inbound_routes")
}

model Announcement {
  id          String  @id @default(cuid())
  name        String
  description String?
  audioId     String?

  // Destino após o anúncio
  destinationApp ApplicationsType
  destinationId  String?

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("announcements")
}

model TimeCondition {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Destino quando condição é verdadeira (dentro do horário)
  trueDestinationApp ApplicationsType
  trueDestinationId  String?

  // Destino quando condição é falsa (fora do horário)
  falseDestinationApp ApplicationsType
  falseDestinationId  String?

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Regras de horário
  timeRules TimeRule[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("timeconditions")
}

model TimeRule {
  id             String         @id @default(cuid())
  name           String
  recurrencyType RecurrencyType

  // Datas (opcional - usado principalmente para CUSTOM e YEARLY)
  startDate DateTime?
  endDate   DateTime?

  // Horários (obrigatório)
  startTime String // Formato HH:mm
  endTime   String // Formato HH:mm

  // Dias da semana (usado para WEEKLY)
  weekDays Int[] @default([]) // [0=Dom, 1=Seg, ..., 6=Sab]

  // Dias do mês (usado para MONTHLY)
  monthDays Int[] @default([]) // [1-31]

  // Meses do ano (usado para YEARLY)
  months Int[] @default([]) // [1-12]

  // Relacionamento com TimeCondition
  timeConditionId String
  timeCondition   TimeCondition @relation(fields: [timeConditionId], references: [id], onDelete: Cascade)

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timeConditionId])
  @@index([companyId])
  @@index([companyId, timeConditionId])
  @@map("timerules")
}

model IVR {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Configurações de comportamento
  audioId    String?
  timeout    Int     @default(5)
  maxRetries Int     @default(3)

  // Ação quando timeout
  timeoutDestinationApp ApplicationsType
  timeoutDestinationId  String?

  // Ação quando opção inválida após maxRetries
  invalidDestinationApp ApplicationsType
  invalidDestinationId  String?

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Opções do menu
  options IVROption[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("ivrs")
}

model IVROption {
  id    String        @id @default(cuid())
  type  IVROptionType @default(DIGIT)
  digit String? // Para type=DIGIT

  // Configurações para INPUT (captura)
  minDigits Int? @default(1)
  maxDigits Int? @default(20)

  // IMPORTANTE: Se type=INPUT, DEVE referenciar uma variável existente
  capturedVariableId String? // FK para Variable
  capturedVariable   Variable? @relation("IVRCapturesVariable", fields: [capturedVariableId], references: [id], onDelete: Restrict)

  // Destino após a opção
  destinationApp ApplicationsType
  destinationId  String?

  // Relacionamento com IVR
  ivrId String
  ivr   IVR    @relation(fields: [ivrId], references: [id], onDelete: Cascade)

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ivrId, digit])
  @@index([ivrId])
  @@index([companyId])
  @@index([companyId, ivrId])
  @@index([capturedVariableId])
  @@map("ivr_options")
}

model Extension {
  id             String        @id @default(cuid())
  name           String // Nome descritivo
  alias          String // Identificador que pode repetir (ex: "1000")
  callerIdName   String
  callerIdNum    String // Número real único GLOBALMENTE
  description    String?
  typeExtension  ExtensionType @default(SIP)
  config         Json
  enableRegister Boolean       @default(false) // Define se faz registro externo
  registerString String? // String de registro customizada

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, alias]) // Alias único por empresa
  @@unique([callerIdNum]) // CallerIdNum único GLOBALMENTE
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("extensions")
}

model Trunk {
  id          String    @id @default(cuid())
  name        String
  description String?
  typeTrunk   TrunkType @default(SIP)
  config      Json

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Rotas de saída
  outboundRoutes OutboundRoute[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("trunks")
}

model OutboundRoute {
  id          String   @id @default(cuid())
  name        String
  description String?
  priority    Int      @default(1)
  patterns    String[] @default([])

  // Relacionamento com Trunk
  trunkId String
  trunk   Trunk  @relation(fields: [trunkId], references: [id], onDelete: Cascade)

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, priority])
  @@index([trunkId])
  @@map("outbound_routes")
}

model ApiRequest {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Configurações da requisição
  method  HttpMethod @default(GET)
  url     String
  headers Json?
  body    Json?
  params  Json?
  timeout Int        @default(5000)

  // Mapeamento de resposta - agora em tabela separada
  responseMappings ApiResponseMapping[]

  // Destino após sucesso
  successDestinationApp ApplicationsType
  successDestinationId  String?

  // Destino após falha
  failureDestinationApp ApplicationsType
  failureDestinationId  String?

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("api_requests")
}

// NOVO: Mapeia campos da resposta da API para variáveis
model ApiResponseMapping {
  id       String @id @default(cuid())
  jsonPath String // Caminho no JSON (ex: "data.cliente.status")

  // Variável que receberá o valor
  variableId String
  variable   Variable @relation("ApiSetsVariable", fields: [variableId], references: [id], onDelete: Restrict)

  // Relacionamento com ApiRequest
  apiRequestId String
  apiRequest   ApiRequest @relation(fields: [apiRequestId], references: [id], onDelete: Cascade)

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([apiRequestId])
  @@index([variableId])
  @@index([companyId])
  @@map("api_response_mappings")
}

model Queue {
  id          String  @id @default(cuid())
  name        String
  description String?
  config      Json

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@map("queues")
}

// ============================================
// VARIÁVEIS - Deve ser criada ANTES de usar
// ============================================

enum VariableSource {
  SYSTEM // Variáveis do sistema Asterisk (CALLERID, EXTEN, CHANNEL, etc)
  MANUAL // Criada manualmente pelo usuário
  IVR_INPUT // Será capturada por IVR
  API_RESPONSE // Virá de ApiRequest
}

enum VariableType {
  STRING // Texto
  NUMBER // Numérico
  BOOLEAN // Verdadeiro/Falso
  JSON // Objeto JSON
}

enum ConditionOperator {
  EQUALS // Igual a
  NOT_EQUALS // Diferente de
  CONTAINS // Contém
  NOT_CONTAINS // Não contém
  STARTS_WITH // Começa com
  ENDS_WITH // Termina com
  GREATER_THAN // Maior que (numérico)
  LESS_THAN // Menor que (numérico)
  GREATER_OR_EQUAL // Maior ou igual (numérico)
  LESS_OR_EQUAL // Menor ou igual (numérico)
  REGEX // Expressão regular
  IS_EMPTY // Está vazio
  IS_NOT_EMPTY // Não está vazio
}

model Variable {
  id           String         @id @default(cuid())
  name         String // Nome da variável (ex: "customer_cpf", "customer_status")
  description  String? // Descrição do que essa variável representa
  source       VariableSource // De onde vem essa variável
  type         VariableType   @default(STRING) // Tipo de dado esperado
  defaultValue String? // Valor padrão ou exemplo (ex: "12345678900", "ATIVO", "VENDAS")

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relacionamentos inversos - onde essa variável é USADA
  usedInIVROptions         IVROption[]          @relation("IVRCapturesVariable")
  usedInSetVariables       SetVariable[]        @relation("SetVariableTarget")
  usedInVariableConditions VariableCondition[]  @relation("ConditionChecksVariable")
  usedInApiResponses       ApiResponseMapping[] @relation("ApiSetsVariable")

  @@unique([companyId, name]) // Nome único por empresa
  @@index([companyId])
  @@index([companyId, source])
  @@index([name])
  @@map("variables")
}

model SetVariable {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Variável que será setada (OBRIGATÓRIO existir)
  variableId String
  variable   Variable @relation("SetVariableTarget", fields: [variableId], references: [id], onDelete: Restrict)

  value String? // Valor a ser atribuído

  // Destino após setar
  destinationApp ApplicationsType
  destinationId  String?

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([variableId])
  @@map("set_variables")
}

model VariableCondition {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Variável que será validada (OBRIGATÓRIO existir)
  variableId String
  variable   Variable @relation("ConditionChecksVariable", fields: [variableId], references: [id], onDelete: Restrict)

  // Regras de validação
  rules VariableConditionRule[]

  // Destino padrão
  defaultDestinationApp ApplicationsType
  defaultDestinationId  String?

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([variableId])
  @@map("variable_conditions")
}

model VariableConditionRule {
  id       String            @id @default(cuid())
  priority Int               @default(1)
  operator ConditionOperator
  value    String?

  // Destino quando condição é verdadeira
  destinationApp ApplicationsType
  destinationId  String?

  // Relacionamento com VariableCondition
  variableConditionId String
  variableCondition   VariableCondition @relation(fields: [variableConditionId], references: [id], onDelete: Cascade)

  // Relacionamento com Company
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variableConditionId])
  @@index([companyId])
  @@index([companyId, variableConditionId])
  @@index([variableConditionId, priority])
  @@map("variable_condition_rules")
}
