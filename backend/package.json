{
    "name": "sofon-pabx-back-end",
    "module": "src/server.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun run --watch src/server.ts",
        "build": "bun build --target=bun src/server.ts --outdir=dist --minify --sourcemap=external",
        "start": "bun dist/server.js",
        "migrate": "bun run prisma migrate dev",
        "deploy": "bun run prisma deploy",
        "generate": "bun run prisma generate",
        "reset": "bun run prisma migrate reset",
        "test": "LOG_ENABLED=false bun test",
        "test:unit": "LOG_ENABLED=false bun test service.test",
        "test:integration": "LOG_ENABLED=false bun test routes.test"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.9.4",
        "@types/uuid": "^11.0.0",
        "prisma": "^7.8.0"
    },
    "peerDependencies": {
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/rate-limit": "^11.1.0",
        "@fastify/swagger": "^9.7.0",
        "@paralleldrive/cuid2": "^3.3.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@scalar/fastify-api-reference": "^1.62.1",
        "argon2": "^0.44.0",
        "axios": "^1.18.1",
        "dotenv": "^17.4.2",
        "fastify": "^5.9.0",
        "fastify-type-provider-zod": "^7.0.0",
        "jsonwebtoken": "^9.0.3",
        "node-cache": "^5.1.2",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "redis": "^6.0.1",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    }
}