        "argon2": "^0.45.1",
        "axios": "^1.20.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.12.3",
        "fastify-type-provider-zod": "^7.0.0",
        "jsonwebtoken": "^9.0.3",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
