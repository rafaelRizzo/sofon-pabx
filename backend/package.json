        "db:studio": "bunx drizzle-kit studio",
        "db:reset": "bun src/db/seed/reset.ts"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/pg": "^8.20.0",
