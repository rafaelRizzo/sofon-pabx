{
    "name": "sofon-pabx-backend",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target=bun --minify --sourcemap",
        "start": "bun dist/index.js",
