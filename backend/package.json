        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/jwt": "^10.0.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/sensible": "^6.0.4",
        "@fastify/static": "^9.0.0",
        "@types/asterisk-manager": "^0.0.1",
        "argon2": "^0.44.0",
        "asterisk-manager": "^0.2.0",
        "dotenv": "^17.4.0",
