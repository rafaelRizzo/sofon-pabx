        "pino-pretty": "^13.1.3",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/rate-limit": "^10.3.0",
        "@sapphire/snowflake": "^3.5.5",
        "argon2": "^0.44.0",
        "bullmq": "^5.76.9",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "esbuild": "^0.28.0",
        "fast-uri": "^3.1.2",
        "fastify": "^5.8.5",
