{
    "name": "sofon-pabx-backend",
    "module": "index.ts",
    "author": "Rafael Rizzo",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch src/index.ts",
        "build": "bun build src/index.ts --outdir dist --target=bun --minify --sourcemap",
        "start": "bun dist/index.js",
        "db:generate": "bunx drizzle-kit generate",
