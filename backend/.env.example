# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Senha do serviço postgres do docker-compose.yml (usada também para compor a DATABASE_URL dos
# services backend/backend-worker) — nunca deixar um valor fixo tipo "senha_forte" versionado.
# Gere com: openssl rand -hex 32
POSTGRES_PASSWORD=change-this-postgres-password

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# O que esse processo sobe: 'web' (só API HTTP, escalável em N réplicas), 'worker' (AGI + AMI
# events + jobs de cron, sempre 1 instância só) ou 'all' (tudo junto — default, usar em dev local
# e em VPS que não precisam escalar em réplicas; ver README raiz "Escalar backend em réplicas")
PROCESS_ROLE=all

# JWT
# Em qualquer NODE_ENV diferente de "test" os dois são OBRIGATÓRIOS, precisam ter >= 32 chars, ser
# distintos entre si e não começar com "your-" — o boot falha caso contrário (ver src/config/env.ts).
# Gere com: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-in-production
REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Master key pra derivar (HKDF, por empresa) a chave AES-256-GCM de segredos de terceiro cifrados
# em repouso (ver src/lib/crypto.ts — hoje só IntegrationCredential.token). Mesma regra do JWT acima:
# obrigatória e forte fora de NODE_ENV=test. Gere com: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=your-encryption-master-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_ENABLED=true

# Timezone fallback para formatar datas nas respostas da API (offset fixo, ex: -03:00) quando o registro
# não tem Company.timezone associado — também usado pro CDR do Asterisk (hora local gravada sem timezone)
TZ=America/Sao_Paulo

# API
API_BASE_URL=http://localhost:3000
API_TIMEOUT=10000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Upload/conversão de áudio: limite de requisições e proteção contra saturação de CPU
AUDIO_UPLOAD_RATE_LIMIT_MAX=5
AUDIO_UPLOAD_RATE_LIMIT_WINDOW=1 minute
AUDIO_CONVERSION_CONCURRENCY=2
AUDIO_CONVERSION_QUEUE_MAX=10
AUDIO_CONVERSION_TIMEOUT_MS=30000

# TTS (ElevenLabs) — a API key é cadastrada por empresa (Company.elevenLabsApiKey), não aqui.
# Isso é só config compartilhada, não secreta.
ELEVENLABS_API_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TIMEOUT_MS=30000

# Redis
# Defina uma string aleatória com pelo menos 32 caracteres, ex: openssl rand -hex 32
REDIS_PASSWORD=change-this-redis-password

# Dialplan estático (timeconditions, announcements, ivrs, holidays, queues-app, request-templates)
# Default é o caminho real do Asterisk — em dev/test sem Asterisk instalado, sobrescreva via .env.test
DIALPLAN_EXTRA_DIR=/etc/asterisk/dialplan-extra

# AMI (Asterisk Manager Interface) — o backend usa pra mandar "dialplan reload" sem depender do
# binário CLI. Em VPS com o backend em network_mode: host, 127.0.0.1 (default) já funciona.
# Sem host network (ex: deploy no Dokploy, ver docker-compose.yml), o container não enxerga o
# host via loopback — trocar para host.docker.internal (resolvido via extra_hosts: host-gateway).
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=admin
AMI_SECRET=

# FastAGI server — o Asterisk nativo (fora do Docker) chama de volta nesse host/porta. Fica
# sempre 127.0.0.1 (visão do Asterisk no host), mesmo sem network_mode: host no backend —
# a porta só precisa estar publicada no compose (ver docker-compose.yml, service backend-worker).
AGI_HOST=127.0.0.1
AGI_PORT=4573
