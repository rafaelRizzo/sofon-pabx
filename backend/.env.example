DATABASE_URL="postgres://user:pass@host:port/db_name"

# JWT Configuration
JWT_SECRET="gerenate-a-secure-random-string-for-jwt-secret"
JWT_REFRESH_SECRET="generate-a-different-secure-random-string-for-refresh"
JWT_EXP="15m"
JWT_REFRESH_EXP="7d"

# Database Pool Configuration (Asterisk + Realtime optimization)
DB_POOL_MAX="20"
DB_POOL_MIN="5"
DB_IDLE_TIMEOUT="30000"
DB_CONNECT_TIMEOUT="5000"

ALLOWED_IPS="localhost,127.0.0.1"
ALLOWED_CORS="localhost,127.0.0.1"

REDIS_URL="redis://:pass@host:port"

SNOWFLAKE_EPOCH='AAAA-MM-DD'
