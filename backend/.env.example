# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT
# Em produção (NODE_ENV=production) os dois são OBRIGATÓRIOS, precisam ter >= 32 chars, ser distintos
# entre si e não começar com "your-" — o boot falha caso contrário. Gere com: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-in-production
REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_ENABLED=true

# Timezone fallback para formatar datas nas respostas da API (offset fixo, ex: -03:00) quando o registro
# não tem Company.timezone associado — também usado pro CDR do Asterisk (hora local gravada sem timezone)
TZ=America/Sao_Paulo

# API
API_BASE_URL=http://localhost:3000
API_TIMEOUT=10000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Redis
REDIS_URL=redis://localhost:6379

# Dialplan estático (timeconditions, announcements, ivrs, holidays, queues-app, request-templates)
# Default é o caminho real do Asterisk — em dev/test sem Asterisk instalado, sobrescreva via .env.test
DIALPLAN_EXTRA_DIR=/etc/asterisk/dialplan-extra
